#!/usr/bin/env python3
# -*- coding: utf-8 -*-
import sys
import re
import argparse
from typing import List, Tuple, Optional

# Type Aliases for better readability
# Segment: (prefix_text, rule_string, suffix_text)
# Rule: (separator, index-1) -> index is converted to 0-based
Segment = Tuple[str, str, str]
Rule = Tuple[str, Optional[int]]

def parse_segments(fmt: str) -> List[Segment]:
    """
    Parse the outermost %...% structure
    """
    segments: List[Segment] = []
    pos = 0
    # Use non-greedy matching for content starting and ending with %
    pattern = re.compile(r'%(.*?)%')

    for m in pattern.finditer(fmt):
        prefix = fmt[pos:m.start()]
        rule_body = m.group(1)  # Get content inside the percent signs
        pos = m.end()
        segments.append((prefix, rule_body, ''))

    # Handle the trailing suffix of the last segment
    if segments:
        p, r, _ = segments[-1]
        segments[-1] = (p, r, fmt[pos:])
    
    return segments

def parse_rule_group(fmt: str) -> List[Tuple[str, List[Rule], str]]:
    """
    Parse the (...) rule groups inside %
    Returns: [(prefix, [rule_list], suffix), ...]
    """
    segments = []
    pos = 0
    # Match parentheses (...)
    pattern = re.compile(r'\((.*?)\)')

    for m in pattern.finditer(fmt):
        prefix = fmt[pos:m.start()]
        rule_body = m.group(1)
        pos = m.end()

        # Parse the specific rule chain, e.g., ":1-1" -> [(':', 1), ('-', 1)]
        rules: List[Rule] = []
        # Regex logic: match any chars (separator) + optional digits (index)
        # Note: Assumes separator is not a digit and index follows immediately
        rule_parts = re.finditer(r'([^0-9]*?)(\d*)', rule_body)
        
        for p in rule_parts:
            sep = p.group(1)
            idx_str = p.group(2)
            
            # Skip empty matches (usually at start or end of string)
            if not sep and not idx_str:
                continue
                
            # Index conversion: Input is 1-based, internal processing is 0-based
            idx = int(idx_str) - 1 if idx_str else None
            rules.append((sep, idx))

        segments.append((prefix, rules, ''))

    # Handle the trailing suffix within the group
    if segments:
        p, r, _ = segments[-1]
        segments[-1] = (p, r, fmt[pos:])
    
    return segments

def apply_rules(data: str, rules: List[Rule]) -> List[str]:
    """
    Recursively apply rules to extract data
    """
    if not rules:
        return [data] if data else []

    sep, idx = rules[0]
    
    # If there is no separator but an index is requested, logic fails
    if not sep and idx is not None:
        return []

    parts = data.split(sep) if sep else [data]

    if idx is not None:
        # Extract specific index
        if 0 <= idx < len(parts):
            return apply_rules(parts[idx], rules[1:])
        else:
            return [] # Index out of bounds
    else:
        # Extract all parts and apply subsequent rules to each
        results = []
        for part in parts:
            results.extend(apply_rules(part, rules[1:]))
        return results

def str_fmt(fmt: str, data: str) -> str:
    """
    Main logic: Combine parsing results
    """
    segments = parse_segments(fmt)
    final_results = []

    # If no % markers found, return original text (or handle as needed)
    if not segments:
        return fmt

    for prefix, rules_str, suffix in segments:
        # 1. Parse internal rules
        rule_groups = parse_rule_group(rules_str)
        
        group_outputs = []
        
        # 2. Process each rule group (...)
        for pre_inner, rules, suf_inner in rule_groups:
            # 3. Apply extraction logic
            extracted_data = apply_rules(data, rules)
            
            # 4. Assemble internal results
            for item in extracted_data:
                group_outputs.append(f"{pre_inner}{item}{suf_inner}")

        # 5. Assemble final result
        if prefix:
            final_results.append(prefix)
        
        if group_outputs:
            # Add space only if not the last element, or adjust separator as needed
            # Preserved original script logic: add space in between
            final_results.extend([f"{p} " for p in group_outputs[:-1]])
            if group_outputs:
                final_results.append(group_outputs[-1])

        if suffix:
            final_results.append(suffix)

    return ''.join(final_results)

def main():
    parser = argparse.ArgumentParser(
        description="Custom string formatting and extraction tool",
        epilog="Example: echo 'a,b,c' | %(,1)%",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("format_string", help="Formatting rule string, e.g., \"Prefix %(,1)% Suffix\"")
    parser.add_argument("input_string", nargs="?", help="Input string (if omitted, reads from stdin)")

    args = parser.parse_args()

    # Handle input source
    inputs = []
    if args.input_string:
        inputs.append(args.input_string)
    else:
        # Check if input is from a pipe
        if not sys.stdin.isatty():
            inputs = sys.stdin.read().splitlines()
        else:
            parser.print_help()
            sys.exit(1)

    # Process each line of input
    for line in inputs:
        line = line.strip()
        if line:
            try:
                print(str_fmt(args.format_string, line))
            except Exception as e:
                print(f"Error processing '{line}': {e}", file=sys.stderr)

if __name__ == "__main__":
    main()
